<?xml version="1.0" encoding="utf-8"?>
<!-- 可滚动 Today — 壳图(原渲染器按容器尺寸渲染: 圆角背景+首屏内容) + 条带 ListView。
     FrameLayout clipToOutline 圆角裁剪 → 条带方形角被裁掉, 露出壳的圆角背景。
     条带与壳同源同坐标系 → 滚动位置 0 与主分支静态渲染逐像素一致。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_scroll_clip"
    android:outlineProvider="background"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/widget_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="false" />
    <!-- v9.3 已知退化 (评估后不修): resize 拖拽期间 host view 连续变化, 壳图只按
         最后 commit 尺寸渲染 → 拖拽中途 fitXY 会短暂拉伸旧壳, 新 commit 落地即恢复。
         根因是 commit-vs-drag 时序 (世代闸刻意丢弃中间提交), 非任何 scaleType 可解:
         fitCenter 会把旧壳缩出黑边, 更差。世代闸收敛语义保留, 在此留档。 -->
    <ListView
        android:id="@+id/widget_strip_list"
        android:overScrollMode="never"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:cacheColorHint="@android:color/transparent"
        android:listSelector="@android:color/transparent" />

    <!-- 固定顶栏 (2026-09-13 用户定稿: 极端档也要有可点的回今天按钮) —
         与 widget_today_nav_static 同一套真实视图顶栏 (标题 + ‹ › + 回今天钮)。
         层序在 ListView 之上: 条带长图不画标题 (emptyHeader), 只保留 24dp 空档,
         本条以不透明底色盖住空档 → 日期只出现一次, 钮恒可点。 -->
    <LinearLayout
        android:id="@+id/widget_today_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widget_today_nav_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/widget_today_nav_prev"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:clickable="true" />

        <LinearLayout
            android:id="@+id/widget_spacer_l"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_today_nav_today"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:clickable="true" />

        <LinearLayout
            android:id="@+id/widget_spacer_r"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_today_nav_next"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:clickable="true" />
    </LinearLayout>
</FrameLayout>
